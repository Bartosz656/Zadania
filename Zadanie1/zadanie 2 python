kierunek = input("Kierunek (C - z Celsjusza, F - z Fahrenheita): ").strip().upper()

if kierunek == "C":
    c = float(input("Podaj temperature w C: ").replace(",", "."))
    f = c * 1.8 + 32
    print(f"{c}C = {f}F")
elif kierunek == "F":
    f = float(input("Podaj temperature w F: ").replace(",", "."))
    c = (f - 32) / 1.8
    print(f"{f}F = {round(c, 2)}C")
else:
    print("Nieznany kierunek.")
