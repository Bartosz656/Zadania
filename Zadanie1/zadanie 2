using System;
using System.Globalization;

class Program
{
    static void Main()
    {
        Console.Write("Kierunek (C - z Celsjusza, F - z Fahrenheita): ");
        string kierunek = Console.ReadLine().Trim().ToUpper();

        if (kierunek == "C")
        {
            Console.Write("Podaj temperature w C: ");
            double c = double.Parse(Console.ReadLine().Replace(',', '.'), CultureInfo.InvariantCulture);
            double f = c * 1.8 + 32;
            Console.WriteLine(c + "C = " + f + "F");
        }
        else if (kierunek == "F")
        {
            Console.Write("Podaj temperature w F: ");
            double f = double.Parse(Console.ReadLine().Replace(',', '.'), CultureInfo.InvariantCulture);
            double c = (f - 32) / 1.8;
            Console.WriteLine(f + "F = " + Math.Round(c, 2) + "C");
        }
        else
        {
            Console.WriteLine("Nieznany kierunek.");
        }
    }
}
