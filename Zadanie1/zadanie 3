using System;
using System.Globalization;

class Program
{
    static void Main()
    {
        Console.Write("Ile ocen chcesz wprowadzic? ");
        int n = int.Parse(Console.ReadLine().Trim());

        double suma = 0;
        for (int i = 1; i <= n; i++)
        {
            Console.Write("Ocena " + i + " (1-6): ");
            suma += double.Parse(Console.ReadLine().Replace(',', '.'), CultureInfo.InvariantCulture);
        }

        double srednia = suma / n;
        Console.WriteLine("Srednia: " + srednia.ToString("0.00", CultureInfo.InvariantCulture));

        if (srednia >= 3.0)
            Console.WriteLine("Uczen zdal.");
        else
            Console.WriteLine("Uczen nie zdal.");
    }
}
